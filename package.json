{
  "name": "agentle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,mjs}\" \"test/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,mjs}\" \"test/**/*.ts\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "fflate": "0.8.3",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
